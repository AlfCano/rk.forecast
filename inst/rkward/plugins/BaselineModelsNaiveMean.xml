								</dropdown>
								<row id="row_sSY2020190">
									<spinbox label="Start Year" id="naive_start_yr" initial="2020" min="1900" max="2100" type="integer" />
									<spinbox label="Start Period" id="naive_start_pd" initial="1" min="1" max="12" type="integer" />
								</row>
							</frame>
							<stretch />
						</column>
					</tab>
					<tab label="Model Configuration" id="tab_MdlCnfgr">
						<column id="clm_fMCMCBMNLS">
							<frame label="Model Configuration" id="frm_MdlCnfgr">
								<radio id="naive_method" label="Baseline Method">
									<option label="Naive (Last observation carries forward)" value="naive" checked="true" />
									<option label="Seasonal Naive (Last season carries forward)" value="snaive" />
									<option label="Mean Forecast (Average of all history)" value="meanf" />
									<option label="Random Walk with Drift (Trend based on first/last)" value="rwf" />
								</radio>
								<spinbox label="Periods to forecast (h)" id="naive_h" initial="12" min="1" max="120" type="integer" />
							</frame>
							<stretch />
						</column>
					</tab>
