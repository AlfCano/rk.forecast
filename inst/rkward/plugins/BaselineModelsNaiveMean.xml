								<dropdown id="naive_theme" label="Plot Theme (ggplot2)">
									<option label="Minimal (Clean business look)" value="minimal" checked="true" />
									<option label="Classic (Scientific)" value="classic" />
									<option label="Black &amp; White (Grid)" value="bw" />
								</dropdown>
								<input label="Main Title (Leave empty for default)" id="naive_plot_main" />
								<input label="X-Axis Label (e.g., Time or Years)" id="naive_plot_xlab" />
								<input label="Y-Axis Label" id="naive_plot_ylab" />
