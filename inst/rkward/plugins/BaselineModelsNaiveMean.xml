	<logic>
		<connect governor="naive_data.available" client="naive_vs.root" />
	</logic>
	<dialog label="Baseline Models (Naive &amp; Mean)">
		<row id="row_vDSDSDFTVF">
			<varselector id="naive_vs" />
			<column id="clm_tDSDSDFTVF">
				<tabbook>
					<tab label="Data &amp; Structure" id="tab_DtStrctr">
						<column id="clm_vDFTVFNTSS">
							<varslot id="naive_data" label="Data Frame" source="naive_vs" classes="data.frame" required="true" />
							<varslot id="naive_target" label="Target Variable to Forecast (Numeric)" source="naive_vs" classes="numeric integer" required="true" />
							<frame label="Time Series Structure" id="frm_TmSrsStr">
								<dropdown id="naive_freq" label="Data Frequency">
									<option label="Monthly (12)" value="12" checked="true" />
